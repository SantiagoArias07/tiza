# Port the API listens on (Render sets this automatically)
PORT=4000

# Postgres connection string. If empty, the server uses a local JSON file
# (server/data/db.json) so it runs with zero setup in development.
# For a FREE, no-expiry database use Neon (https://neon.com) and paste its
# POOLED connection string here (host contains "-pooler"), e.g.
#   postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Secret used to sign login tokens (JWT). Use a long random string in production.
JWT_SECRET=

# Comma-separated allowed frontend origins for CORS.
# In production set this to your Vercel URL, e.g. https://tiza.vercel.app
CORS_ORIGIN=*

# Optional off-database daily backup mirror to a PRIVATE GitHub repository.
# Leave blank to disable. GITHUB_BACKUP_REPO = "owner/repo" (must be PRIVATE);
# GITHUB_BACKUP_TOKEN = fine-grained PAT scoped to that repo, Contents: Read+Write.
# (Do NOT use a Gist — Gists are publicly readable by URL.)
GITHUB_BACKUP_REPO=
GITHUB_BACKUP_TOKEN=
